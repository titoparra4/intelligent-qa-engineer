# Copy to .env (git-ignored) only if you target something other than the
# embedded local mock. Never commit real tokens.
API_BASE_URL=http://127.0.0.1:8000
API_USER_TOKEN=<user-token>
API_ADMIN_TOKEN=<admin-token>
API_TIMEOUT_SECONDS=5
# Required to run against a non-local host (you must be authorized):
# ALLOW_REMOTE_TESTS=1
# Required to run destructive tests against a non-local host:
# ALLOW_DESTRUCTIVE_TESTS=1
